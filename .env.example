# ===================================================
# MAA TARINI ASTRO VISION - SMTP CONFIGURATION
# ===================================================
# For Gmail:
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Enable 2-Step Verification
# 3. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 4. Generate a new App Password for Mail / Website
# 5. Paste the 16-character password into .env.local as SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=maatariniastrovision@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here
SMTP_FROM=Maa Tarini Astro Vision <maatariniastrovision@gmail.com>
ADMIN_EMAIL=maatariniastrovision@gmail.com
